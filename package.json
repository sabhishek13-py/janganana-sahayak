    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "groq-sdk": "^1.6.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.38.0",
    "next": "^15.5.25",
    "next-intl": "^4.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
