# Copy to .env.local and fill in what you need. Every value is optional:
# each absent one disables a single feature rather than breaking the app.

# The assistant features. Without it, AI routes answer 503.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Must support strict structured outputs. See the README before changing.
# GROQ_MODEL=openai/gpt-oss-20b

# "Use my location" on the schedule page. Without it, the manual picker is used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opt-in analytics. Without it, no analytics and no consent bar.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase App Check, so only attested app instances can spend model quota.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
FIREBASE_PROJECT_NUMBER=
APP_CHECK_ENFORCED=false

# Per-client token bucket on the AI routes.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=5

# How many proxies in front of this app append to x-forwarded-for.
TRUSTED_PROXY_HOPS=1
